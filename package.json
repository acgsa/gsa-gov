{
  "name": "gsa-gov",
  "version": "0.1.0",
  "private": true,
  "description": "GSA.GOV public-facing website — Next.js 15 + Payload CMS 3.x",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run test",
    "payload:migrate": "node -e \"require('payload/dist/bin/payload').runCLI(['migrate'])\"",
    "payload:generate:types": "payload generate:types",
    "a11y": "axe-core --dir ./src"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.13.0",
    "@mozilla/readability": "0.6.0",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "autoprefixer": "10.5.0",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.40.0",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "payload": "3.85.0",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.29",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.10.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-security": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "tsx": "4.23.12",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
