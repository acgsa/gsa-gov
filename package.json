{
  "name": "gsa-gov",
  "version": "0.1.0",
  "private": true,
  "description": "GSA.GOV public-facing website — Next.js 15 + Payload CMS 3.x",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run test",
    "payload:migrate": "node -e \"require('payload/dist/bin/payload').runCLI(['migrate'])\"",
    "payload:generate:types": "payload generate:types",
    "a11y": "axe-core --dir ./src"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "next": "16.2.7",
    "payload": "3.85.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.10.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.4.11",
    "eslint-plugin-security": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
