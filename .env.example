# =============================================================================
# GSA.GOV Local Development Environment
# =============================================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env — it is in .gitignore.
# Production secrets are managed via cloud.gov user-provided services.
# =============================================================================

# --- Payload CMS ---
# Secret key for Payload CMS sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Database ---
# PostgreSQL connection string for local development (matches docker-compose.yml)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/gsa_gov

# --- Next.js ---
# Public site URL (used for absolute URLs, canonical tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload Admin ---
# URL of the Payload admin panel
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# --- S3-compatible Storage (optional for local) ---
# For local development you can skip these or use LocalStack / MinIO
# S3_BUCKET=
# S3_REGION=us-gov-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # for LocalStack: http://localhost:4566

# =============================================================================
# cloud.gov production environment
# In production, these are set via `cf set-env` or user-provided services.
# Do NOT add production values here.
# =============================================================================
